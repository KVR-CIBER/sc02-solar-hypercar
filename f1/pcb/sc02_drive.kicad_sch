	(text "SC-02 DRIVE BOARD v1.0 - ESP32-S3 + 2x DRV8871 + INA226 + 5 V 5 A buck, sits on the Raspberry Pi 4 like a HAT (generated by tools/build_sch.py from tools/design.py)"
		(exclude_from_sim no)
		(at 15 552 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "a04740e4-7f3b-5434-8e60-fe002c8b7d42")
	)
	(text "Battery 3S LiPo (9-12.6 V) -> P-MOSFET reverse protection -> 2 mOhm shunt (INA226 @ 0x40, I2C IO1/IO2) -> VBUS: motors + buck. Buck 5 V -> Pi 4 header pins 2/4, servo, hall, lights."
		(exclude_from_sim no)
		(at 15 556 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
